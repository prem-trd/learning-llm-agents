# Copy this file to .env and fill in your key.
# Get a free Ollama Cloud API key at https://ollama.com/settings

# --- Ollama Cloud (use this now) ---
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your-ollama-cloud-key-here
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- Local Ollama (switch to this later, no code changes needed) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=gpt-oss:20b

# --- Level 7 (Production) ---
# A secret YOU make up to protect the example servers in level-7-production/
# — completely separate from your Ollama key. Change it to anything.
APP_API_KEY=dev-secret-123
